{
    "mcpServers": {
        "playwright": {
            "command": "bunx",
            "args": ["@playwright/mcp"]
        },
        "postgres": {
            "command": "bunx",
            "args": ["@modelcontextprotocol/server-postgres", "${DATABASE_URL}"]
        },
        "github": {
            "command": "bunx",
            "args": ["@modelcontextprotocol/server-github"],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PAT}"
            }
        },
        "fetch": {
            "command": "uvx",
            "args": ["mcp-server-fetch"]
        },
        "docker": {
            "command": "uvx",
            "args": ["mcp-server-docker"]
        },
        "penpot": {
            "command": "uvx",
            "args": ["penpot-mcp"],
            "env": {
                "PENPOT_API_URL": "${PENPOT_API_URL}",
                "PENPOT_USERNAME": "${PENPOT_USERNAME}",
                "PENPOT_PASSWORD": "${PENPOT_PASSWORD}"
            }
        },
        "figma": {
            "command": "bunx",
            "args": ["@smithery/cli", "run", "@deepsuthar496/figma-mcp-server"],
            "env": {
                "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}"
            }
        }
    }
}

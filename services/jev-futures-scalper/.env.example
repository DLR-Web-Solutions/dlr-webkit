# Safe default: the service refuses to start unless this is exactly true.
PAPER_MODE=true

# Public market-data sample only; this is Binance Spot, not Futures.
SYMBOL=btcusdt

# Future risk-design limits only. No orders or leverage are applied.
MAX_LEVERAGE=3
RISK_PER_TRADE_PCT=0.25
DAILY_LOSS_LIMIT_PCT=1.0

# Internal container settings.
PORT=8080
DATA_DIR=/data

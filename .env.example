# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# NODE_ENV=development|test|production
NODE_ENV=development
APP_NAME=[APP_NAME]
APP_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Docker Host & Container Port Mapping (required for compose)
# -----------------------------------------------------------------------------
# Change APP_PORT and DB_PORT per machine / VPS to avoid collisions.
APP_PORT=8000
CONTAINER_PORT=8000

DB_PORT=5432
DB_DATABASE=app_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Prefer DATABASE_URL in app code; keep DB_* for compose postgres service.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/app_db

# -----------------------------------------------------------------------------
# Auth / sessions (fill when implementing auth — never commit real secrets)
# -----------------------------------------------------------------------------
# SESSION_SECRET=
# JWT_SECRET=

# -----------------------------------------------------------------------------
# Frontend public env (NEVER put secrets in VITE_* / NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
# VITE_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# AI providers (optional — only for AI-powered products)
# -----------------------------------------------------------------------------
# AI_PROVIDER=openai|anthropic|gemini|ollama
# AI_MODEL=
# AI_BASE_URL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# MCP / tooling (local agent machines only — optional)
# -----------------------------------------------------------------------------
# GITHUB_PAT=
# FIGMA_ACCESS_TOKEN=
# PENPOT_API_URL=
# PENPOT_USERNAME=
# PENPOT_PASSWORD=
